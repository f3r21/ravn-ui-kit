{
  "name": "@ravn/ui-kit",
  "version": "0.5.2",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./theme.css": "./dist/theme.css",
    "./ui-kit.css": "./dist/ui-kit.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build",
    "build:storybook": "storybook build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tooling.json",
    "test": "vitest run",
    "test:a11y": "test-storybook --url http://127.0.0.1:6006",
    "test:a11y:ci": "concurrently -k -s first -n SB,A11Y -c magenta,blue \"http-server storybook-static --port 6006 --silent -c-1\" \"wait-on tcp:127.0.0.1:6006 && npm run test:a11y\"",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "npm run typecheck && npm run lint && npm run format:check && npm run coverage"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.0",
    "react": "^19.0.0",
    "react-aria": "^3.37.0",
    "react-dom": "^19.0.0",
    "react-stately": "^3.35.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@internationalized/date": "^3.12.3",
    "@storybook/addon-a11y": "^8.5.3",
    "@storybook/addon-docs": "8.6.14",
    "@storybook/addon-essentials": "^8.5.3",
    "@storybook/addon-interactions": "^8.5.3",
    "@storybook/addon-links": "^8.5.3",
    "@storybook/react": "^8.5.3",
    "@storybook/react-vite": "^8.5.3",
    "@storybook/test": "^8.5.3",
    "@storybook/test-runner": "^0.22.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-playwright": "^2.2.2",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^0.11.6",
    "globals": "^17.9.0",
    "http-server": "^14.1.1",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.6",
    "react-aria": "^3.37.0",
    "react-stately": "^3.35.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^8.5.3",
    "storybook-addon-pseudo-states": "^4.0.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
